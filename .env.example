# Obavezno: lozinka za ulaz u aplikaciju (koristi se samo pri prvom pokretanju,
# kasnije se lozinka mijenja u aplikaciji i čuva u bazi)
APP_PASSWORD=promijeni-me

# Javna adresa aplikacije (koristi se u emailu i push porukama)
APP_URL=https://kalendar.badxmedia.com

# Gdje se sprema SQLite baza (u Dockeru ostavi /data i mountaj volumen)
DATA_DIR=/data

# Vremenska zona za raspored (nedjelja 19:00 po ovoj zoni)
TZ_NAME=Europe/Zagreb

# --- Email (opcionalno). Ako ostane prazno, radi samo push. ---
# Gmail: uključi 2-step verification pa napravi "App password" (16 znakova).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tvoj.mail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Kalendar instrukcija <tvoj.mail@gmail.com>"
# Na koju adresu stiže tjedni pregled (može se promijeniti i u aplikaciji)
NOTIFY_EMAIL=mama@gmail.com
